{
  "name": "xunxintai",
  "private": true,
  "version": "1.6.31",
  "description": "洵心台 - 具备本地原生能力的 AI 桌面助手",
  "author": {
    "name": "Qiao-920",
    "email": "Qiao-920@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/XunLi1127/xunxintai.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "node --test electron/test/*.test.cjs",
    "check": "npm test && npm run test:electron && npm run build",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "runtime:prepare": "node scripts/prepare-runtime.cjs --platform win32 --arch x64",
    "runtime:check": "node scripts/check-runtime.cjs --platform win32 --arch x64",
    "electron:build:win": "npm run runtime:prepare && npm run runtime:check && vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "beforePack": "scripts/before-pack.cjs",
    "appId": "com.xunxintai.desktop",
    "productName": "洵心台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [],
    "extraResources": [
      {
        "from": "engine/src",
        "to": "engine/src",
        "filter": [
          "**/*.ts",
          "**/*.tsx",
          "**/*.js",
          "**/*.json",
          "**/*.md",
          "**/*.txt"
        ]
      },
      {
        "from": "engine/bin",
        "to": "engine/bin"
      },
      {
        "from": "engine/preload.ts",
        "to": "engine/preload.ts"
      },
      {
        "from": "engine/bunfig.toml",
        "to": "engine/bunfig.toml"
      },
      {
        "from": "engine/package.json",
        "to": "engine/package.json"
      },
      {
        "from": "engine/tsconfig.json",
        "to": "engine/tsconfig.json"
      },
      {
        "from": "engine/stubs",
        "to": "engine/stubs"
      },
      {
        "from": "engine/node_modules",
        "to": "engine/node_modules"
      },
      {
        "from": "engine/vision-helper.ts",
        "to": "engine/vision-helper.ts"
      },
      {
        "from": "engine/bun.lock",
        "to": "engine/bun.lock"
      },
      {
        "from": "engine/.env.defaults",
        "to": "engine/.env.defaults"
      },
      {
        "from": "public/favicon.ico",
        "to": "assets/favicon.ico"
      },
      {
        "from": "public/favicon.png",
        "to": "assets/favicon.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "XunLi1127",
      "repo": "xunxintai"
    },
    "win": {
      "artifactName": "Xunxintai-Setup-${version}-${arch}.${ext}",
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon-mac.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/favicon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/spectral": "^5.2.8",
    "@remix-run/router": "1.15.3",
    "archiver": "^7.0.1",
    "core-util-is": "^1.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "inherits": "^2.0.4",
    "isarray": "^2.0.5",
    "katex": "^0.16.28",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.12.2",
    "multer": "^2.1.1",
    "picomatch": "4.0.3",
    "png-chunks-extract": "^1.0.0",
    "pngjs": "^7.0.0",
    "process-nextick-args": "^2.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "9.0.1",
    "react-router-dom": "6.22.3",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.7.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "string_decoder": "^1.3.0",
    "util-deprecate": "^1.0.2",
    "uuid": "^13.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/katex": "^0.16.8",
    "@types/mermaid": "^9.1.0",
    "@types/node": "^22.14.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^26.1.0",
    "png-chunks-encode": "^1.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
